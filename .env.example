# Copy to .env for local work. NEVER commit real values.
APP_ENV=development                 # production on Railway
SECRET_KEY=change-me                # required in production: python -c "import secrets;print(secrets.token_urlsafe(48))"
DATABASE_URL=                       # Railway: reference the PostgreSQL service variable; empty = local SQLite (dev only)

# First administrator, created on startup only if the username does not exist yet
ADMIN_USERNAME=
ADMIN_PASSWORD=                     # min 8 chars, letters + digits
ADMIN_PHONE=+998901234567
ADMIN_FIRST_NAME=Site
ADMIN_LAST_NAME=Admin

# Optional
BACKUP_DATABASE_URL=                # separate PostgreSQL for backups (recommended)
PDF_MAX_MB=25
PDF_MAX_PAGES=300
OCR_LANGS=uzb+uzb_cyrl+rus+eng
TZ_OFFSET_HOURS=5                   # site time zone offset from UTC (Uzbekistan = 5)
RUN_SCHEDULER=1                     # 0 disables the in-process backup scheduler
